;; com.etzhayyim.mitsuho.silenAgricultureReview — lexicon (EDN form) — Council attestation scope for silent agriculture
{:lexicon 1
 :id "com.etzhayyim.mitsuho.silenAgricultureReview"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["reviewId" "actorDid" "reviewDate" "scope" "councilDecision" "decisionRationale"]
    :properties
    {:reviewId           {:type "string" :description "Unique identifier for the review."}
     :actorDid           {:type "string" :description "DID of the actor being reviewed (e.g., mitsuho itself)."}
     :reviewDate         {:type "string" :format "date-time" :description "Date of the Council review."}
     :scope              {:type "string" :description "Scope of the review (e.g., 'GMO approval', 'Soil Carbon Negativity')."}
     :councilDecision    {:type "string" :description "Council's decision (e.g., 'approved', 'rejected', 'pending')."}
     :decisionRationale  {:type "string" :description "Rationale behind the Council's decision."}
     :attestationCids    {:type "array" :items {:type "string"} :description "List of CIDs for supporting attestations."}}}}}}
