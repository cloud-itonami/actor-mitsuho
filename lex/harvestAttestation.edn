;; com.etzhayyim.mitsuho.harvestAttestation — lexicon (EDN form) — attestation for crop harvests
{:lexicon 1
 :id "com.etzhayyim.mitsuho.harvestAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["harvestId" "cropPlanId" "harvestDate" "yieldQuantityKg" "qualityGrade" "witnessSigs" "ipfsPhotoCid" "soilCarbonDeltaTonsCo2Eq"]
    :properties
    {:harvestId          {:type "string" :description "Unique identifier for the harvest event."}
     :cropPlanId         {:type "string" :description "Reference to the crop plan that led to this harvest."}
     :harvestDate        {:type "string" :format "date-time" :description "Date and time of the harvest."}
     :yieldQuantityKg    {:type "number" :description "Total yield quantity in kilograms."}
     :qualityGrade       {:type "string" :description "Quality grade of the harvested produce."}
     :witnessSigs        {:type "array" :items {:type "string"} :description "List of DIDs of witnesses who attested to the harvest."}
     :ipfsPhotoCid       {:type "string" :description "IPFS Content ID of photographic evidence of the harvest."}
     :soilCarbonDeltaTonsCo2Eq {:type "number" :description "Change in soil carbon (tons CO2 equivalent) post-harvest (G8)."}
     :harvestMethod      {:type "string" :description "Method used for harvesting (e.g., manual, robotic)."}}}}}}
