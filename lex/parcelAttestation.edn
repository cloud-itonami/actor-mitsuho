;; com.etzhayyim.mitsuho.parcelAttestation — lexicon (EDN form) — baseline attestation for agricultural parcels
{:lexicon 1
 :id "com.etzhayyim.mitsuho.parcelAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["parcelId" "attestationDate" "soilHealthScore" "waterQualityScore" "biodiversityImpact"]
    :properties
    {:parcelId           {:type "string" :description "Unique identifier for the agricultural parcel."}
     :attestationDate    {:type "string" :format "date-time" :description "Date and time of the attestation."}
     :soilHealthScore    {:type "number" :description "Score reflecting soil organic matter, microbial activity, and nutrient levels."}
     :waterQualityScore  {:type "number" :description "Score reflecting water purity and suitability for agriculture."}
     :climateZone        {:type "string" :description "Climate zone classification for the parcel (e.g., Koppen classification)."}
     :biodiversityImpact {:type "string" :description "Assessment of impact on local biodiversity (e.g., no-harm, positive-impact)."}
     :locationGeohash    {:type "string" :description "Geohash of the parcel's central location."}}}}}}
