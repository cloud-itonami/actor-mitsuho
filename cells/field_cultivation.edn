;; mitsuho 瑞穂 — field_cultivation cell (langgraph, WASM runtime)
;; Manages field preparation, planting, and initial crop care.
{:cell/id "field_cultivation"
 :cell/glyph "畑"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "methods/agent.cljc"
 :cell/handler "handle_field_cultivation"
 :cell/doc "Manages field preparation, planting, and initial crop care, including soil analysis and seeding based on crop plans."
 :cell/state-graph
 {:nodes [:prepare-soil :plant-seeds :monitor-growth :initial-care]
  :entry :prepare-soil
  :edges [[:prepare-soil :plant-seeds] [:plant-seeds :monitor-growth]
          [:monitor-growth :initial-care] [:initial-care :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G2" "G5" "G7" "G8" "G9" "G10"]
 :cell/kotoba
 {:reads [:parcelAttestation/id :parcelAttestation/soil-data :cropPlanAttestation/id :cropPlanAttestation/varietals :cropPlanAttestation/pesticide-manifest]
  :writes [:fieldCultivation/id :fieldCultivation/status :fieldCultivation/timestamp]}}
