;; mitsuho 瑞穂 — harvest_robotics cell (langgraph, WASM runtime)
;; Orchestrates autonomous robotics for harvesting crops.
{:cell/id "harvest_robotics"
 :cell/glyph "収"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "methods/agent.cljc"
 :cell/handler "handle_harvest_robotics"
 :cell/doc "Orchestrates autonomous robotics for precise and efficient harvesting of crops and aquatic species, integrating with robot fleet management."
 :cell/state-graph
 {:nodes [:plan-harvest :deploy-robots :execute-harvest :collect-data]
  :entry :plan-harvest
  :edges [[:plan-harvest :deploy-robots] [:deploy-robots :execute-harvest]
          [:execute-harvest :collect-data] [:collect-data :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G2" "G5"]
 :cell/kotoba
 {:reads [:cropPlanAttestation/id :harvestAttestation/id :robotFleet/id :robotFleet/status]
  :writes [:harvestLog/id :harvestLog/robot-action :harvestLog/timestamp]}}
