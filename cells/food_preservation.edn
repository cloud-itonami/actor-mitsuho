;; mitsuho 瑞穂 — food_preservation cell (langgraph, WASM runtime)
;; Manages the processing and preservation of harvested food.
{:cell/id "food_preservation"
 :cell/glyph "蔵"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "methods/agent.cljc"
 :cell/handler "handle_food_preservation"
 :cell/doc "Manages the processing and preservation of harvested food, ensuring quality, safety, and extending shelf-life before distribution."
 :cell/state-graph
 {:nodes [:receive-harvest :process-food :package-store :quality-check]
  :entry :receive-harvest
  :edges [[:receive-harvest :process-food] [:process-food :package-store]
          [:package-store :quality-check] [:quality-check :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G2" "G5"]
 :cell/kotoba
 {:reads [:harvestAttestation/id :foodLotAttestation/id :foodLotAttestation/shelf-life]
  :writes [:preservationLog/id :preservationLog/method :preservationLog/timestamp]}}
