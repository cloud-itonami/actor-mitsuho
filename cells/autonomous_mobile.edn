;; mitsuho 瑞穂 — autonomous_mobile cell (langgraph, WASM runtime)
;; Manages the autonomous mobile robotics fleet for various agricultural tasks.
{:cell/id "autonomous_mobile"
 :cell/glyph "自"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "methods/agent.cljc"
 :cell/handler "handle_autonomous_mobile"
 :cell/doc "Manages the autonomous mobile robotics fleet for various agricultural tasks, including field monitoring, pest control, and logistics."
 :cell/state-graph
 {:nodes [:task-assignment :path-planning :execute-mission :report-status]
  :entry :task-assignment
  :edges [[:task-assignment :path-planning] [:path-planning :execute-mission]
          [:execute-mission :report-status] [:report-status :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G2" "G5"]
 :cell/kotoba
 {:reads [:robotFleet/id :robotFleet/task :robotFleet/location]
  :writes [:mobileRobotLog/id :mobileRobotLog/action :mobileRobotLog/timestamp]}}
