;; mitsuho 瑞穂 — aquaculture cell (langgraph, WASM runtime)
;; Manages controlled environment fish and aquatic plant cultivation.
{:cell/id "aquaculture"
 :cell/glyph "水"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "methods/agent.cljc"
 :cell/handler "handle_aquaculture"
 :cell/doc "Manages controlled environment fish and aquatic plant cultivation, including water quality monitoring and feeding schedules."
 :cell/state-graph
 {:nodes [:prepare-tanks :introduce-species :monitor-water :feed-care]
  :entry :prepare-tanks
  :edges [[:prepare-tanks :introduce-species] [:introduce-species :monitor-water]
          [:monitor-water :feed-care] [:feed-care :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G2" "G5"]
 :cell/kotoba
 {:reads [:aquacultureSystem/id :aquacultureSystem/water-parameters :aquacultureSystem/species :foodLotAttestation/id]
  :writes [:aquacultureLog/id :aquacultureLog/event :aquacultureLog/timestamp]}}
